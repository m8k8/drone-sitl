# Apply after upstream Tools/autotest/default_params/copter.parm.
# Provisional B-D prototype model, not real-aircraft tuning.
FRAME_CLASS 1
FRAME_TYPE 1
ARMING_SKIPCHK 0
MOT_PWM_MIN 1050
MOT_PWM_MAX 1950
MOT_SPIN_MIN 0.224
MOT_SPIN_MAX 1.0
MOT_SPIN_ARM 0.10
MOT_THST_EXPO 0
MOT_THST_HOVER 0.30
MOT_HOVER_LEARN 2
MOT_BAT_VOLT_MIN 42.0
MOT_BAT_VOLT_MAX 50.4
SIM_BATT_VOLTAGE 50.4
SIM_BATT_CAP_AH 10.0
BATT_CAPACITY 10000
BATT_LOW_VOLT 42.0
BATT_CRT_VOLT 40.8
BATT_LOW_MAH 2000
BATT_CRT_MAH 1000
BATT_FS_LOW_ACT 1
BATT_FS_CRT_ACT 1
ATC_ACC_R_MAX 360
ATC_ACC_P_MAX 360
ATC_ACC_Y_MAX 180
WP_SPD 3
WP_ACC 1
WP_SPD_UP 1.5
WP_SPD_DN 1
RTL_SPEED_MS 3
RTL_ALT_M 15
RTL_LOIT_TIME 2000
LAND_SPD_MS 0.5
SIM_WIND_SPD 0
SIM_SPR_ENABLE 0
SPRAY_ENABLE 0
SIM_GRPS_ENABLE 0
SIM_GRPE_ENABLE 0
SIM_GPS2_ENABLE 0
PLND_ENABLED 0
# TF02-Pro uses the current Benewake driver. The native tf03 emulator
# generates the compatible UART packet at5Hz, not a full TF02-Pro optics model.
SERIAL5_PROTOCOL 9
SERIAL5_BAUD 115
RNGFND1_TYPE 27
RNGFND1_MIN 0.1
RNGFND1_MAX 13.5
RNGFND1_ORIENT 25
RNGFND1_GNDCLR 0.1
RNGFND1_POS_X 0
RNGFND1_POS_Y 0
RNGFND1_POS_Z 0
SURFTRAK_MODE 1
SIM_SONAR_ROT 25
SIM_SONAR_POS_X 0
SIM_SONAR_POS_Y 0
SIM_SONAR_POS_Z 0
SIM_SONAR_RND 0.02
# Height EKF remains barometer based; surface tracking is a separate control path.
EK3_SRC1_POSZ 1
EK3_RNG_USE_HGT -1
