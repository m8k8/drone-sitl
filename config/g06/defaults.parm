# Apply after upstream Tools/autotest/default_params/copter.parm.
# Simulation only: these are provisional model settings, not real-aircraft tuning.
FRAME_CLASS 1
FRAME_TYPE 1
ARMING_SKIPCHK 0
MOT_PWM_MIN 1050
MOT_PWM_MAX 1950
# Numerical fit of the measured thrust curve, not a measured ESC deadband.
MOT_SPIN_MIN 0.224
MOT_SPIN_MAX 1.0
MOT_SPIN_ARM 0.10
MOT_THST_EXPO 0
MOT_THST_HOVER 0.30
MOT_HOVER_LEARN 2
MOT_BAT_VOLT_MIN 42.0
MOT_BAT_VOLT_MAX 50.4
SIM_BATT_VOLTAGE 50.4
SIM_BATT_CAP_AH 10.0
BATT_CAPACITY 10000
BATT_LOW_VOLT 42.0
BATT_CRT_VOLT 40.8
BATT_LOW_MAH 2000
BATT_CRT_MAH 1000
# Land on low/critical battery. Do not bypass the normal arm checks.
BATT_FS_LOW_ACT 1
BATT_FS_CRT_ACT 1
ATC_ACC_R_MAX 360
ATC_ACC_P_MAX 360
ATC_ACC_Y_MAX 180
WP_SPD 3
WP_ACC 1
WP_SPD_UP 1.5
WP_SPD_DN 1
RTL_SPEED_MS 3
RTL_ALT_M 15
RTL_LOIT_TIME 2000
LAND_SPD_MS 0.5
SIM_WIND_SPD 0
SIM_SPR_ENABLE 0
SPRAY_ENABLE 0
SIM_GRPS_ENABLE 0
SIM_GRPE_ENABLE 0
RNGFND1_TYPE 0
SIM_GPS2_ENABLE 0
PLND_ENABLED 0
